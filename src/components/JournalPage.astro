---
// The "journal page" frame shared by the Stage 4 sections:
// running header at the top, a left margin rail with the big entry number, and a footer
// that links to the next entry. Each section fills the rail (slot "rail") and the page body.
interface Props {
  id: string;
  entry: string; // "01"
  name: string; // "The Person"
  next: { name: string; href: string };
  titled?: boolean; // true: the running header's centre text is the section's heading
  grid?: boolean; // faint blueprint grid (Acts II-III only)
}

const { id, entry, name, next, titled = false, grid = false } = Astro.props;
const titleId = `${id}-title`;
const Centre = titled ? 'h2' : 'span';
---

<section id={id} class:list={['page', { 'page--grid': grid }]} aria-labelledby={titleId}>
  <div class="page__head">
    <span class="page__journal">Open Build Journal</span>
    <Centre class="page__entry" id={titled ? titleId : undefined}>Entry {entry} — {name}</Centre>
    <span class="page__folio">P. {entry}</span>
  </div>

  <div class="page__body">
    <div class="page__rail">
      <span class="page__num" aria-hidden="true">{entry}</span>
      <slot name="rail" />
    </div>
    <div class="page__main">
      <slot />
    </div>
  </div>

  <footer class="page__foot">
    <span class="page__end">End of Entry {entry}</span>
    <a class="page__next" href={next.href}>Next entry — {next.name} <span class="arrow" aria-hidden="true">→</span></a>
  </footer>
</section>

<style>
  .page {
    padding: var(--space-6) var(--margin-page) var(--space-7);
    background: var(--bg);
  }

  .page--grid {
    border-top: var(--line) solid var(--rule);
    background-color: var(--bg-raised);
    background-image:
      linear-gradient(var(--grid) var(--line), transparent var(--line)),
      linear-gradient(90deg, var(--grid) var(--line), transparent var(--line));
    background-size: var(--space-8) var(--space-8);
    background-position: calc(var(--margin-page) - var(--line)) 0;
  }

  /* ---------- Running header ---------- */
  .page__head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--line) solid var(--rule);
  }

  .page__head > *,
  .page__end {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .page__folio {
    text-align: right;
  }

  /* ---------- Rail + body ---------- */
  .page__body {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--space-7);
    padding: var(--space-9) 0 var(--space-10);
  }

  /* Decorative: the entry is already named in the running header. */
  .page__num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-rail);
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  /* ---------- Footer ---------- */
  .page__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--line) solid var(--rule);
  }

  .page__next {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  .page__next:hover,
  .page__next:focus-visible {
    text-decoration: underline;
  }

  .page__next .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .page__next:hover .arrow,
  .page__next:focus-visible .arrow {
    transform: translateX(4px);
  }

  /* ---------- Mobile: the number moves above the content ---------- */
  @media (max-width: 860px) {
    .page {
      padding-top: var(--space-5);
    }

    .page--grid {
      background-size: var(--space-7) var(--space-7);
    }

    /* Three labels don't fit on one line at phone width; the entry name and page number stay. */
    .page__head {
      grid-template-columns: 1fr auto;
    }

    .page__journal {
      display: none;
    }

    .page__body {
      display: block;
      padding: var(--space-7) 0 var(--space-9);
    }

    .page__rail {
      margin-bottom: var(--space-6);
    }

    .page__foot {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
