---
// TEMPORARY page for Stage 2: compare three font pairings on the real photo.
// Delete this file (and the Google Fonts link below) once a pairing is chosen.
import { Image } from 'astro:assets';
import '../styles/global.css';
import heroDesktop from '../assets/hero/hero-desktop.jpg.jpg';

const pairings = [
  {
    id: 'a',
    name: 'A',
    fonts: 'Instrument Serif + Inter + JetBrains Mono',
  },
  {
    id: 'b',
    name: 'B',
    fonts: 'Fraunces + Manrope + IBM Plex Mono',
  },
  {
    id: 'c',
    name: 'C',
    fonts: 'Newsreader + Geist + Geist Mono',
  },
];

const fontsUrl =
  'https://fonts.googleapis.com/css2' +
  '?family=Instrument+Serif:ital@0;1' +
  '&family=Inter:wght@400;500' +
  '&family=JetBrains+Mono:wght@400' +
  '&family=Fraunces:ital,opsz,wght@0,9..144,300..500;1,9..144,300..500' +
  '&family=Manrope:wght@400;500;600' +
  '&family=IBM+Plex+Mono:wght@400' +
  '&family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500' +
  '&family=Geist:wght@400;500' +
  '&family=Geist+Mono:wght@400' +
  '&display=swap';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Type test — Open Build Journal</title>
    <!-- Test only: fonts load from Google Fonts. Not part of the final site. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsUrl} />
  </head>
  <body>
    {
      pairings.map((p, i) => (
        <section class={`pairing pairing-${p.id}`} aria-label={`Pairing ${p.name}`}>
          <p class="caption">
            <strong>{p.name}</strong> · {p.fonts}
          </p>

          <div class="hero">
            <Image
              class="hero-photo"
              src={heroDesktop}
              alt="Portrait of Muhammad Ukasha looking up toward window light"
              widths={[1200, 1800, 2400]}
              sizes="100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />

            <p class="label name">Muhammad Ukasha</p>

            <div class="copy">
              <p class="mono entry">Entry 001</p>
              <h2 class="headline">
                Learning<br />
                <em>by building.</em>
              </h2>
            </div>
          </div>
        </section>
      ))
    }
  </body>
</html>

<style>
  /* Caption bar above each hero, in a neutral font so it never
     takes on the look of the pairing being judged. */
  .caption {
    margin: 0;
    max-width: none;
    padding: var(--space-3) var(--margin-page);
    background: var(--color-charcoal);
    color: var(--color-ivory);
    font: 500 0.8125rem/1.4 system-ui, sans-serif;
    letter-spacing: 0.04em;
  }

  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background: var(--color-ivory);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* keep the face in frame when the screen is narrower than the photo */
    object-position: 65% 30%;
  }

  .name {
    position: absolute;
    top: var(--margin-page);
    left: var(--margin-page);
    margin: 0;
    color: var(--text);
  }

  .copy {
    position: absolute;
    left: var(--margin-page);
    bottom: 22%;
    /* the empty wall ends around a third of the way across the photo */
    max-width: 34vw;
  }

  .entry {
    margin: 0 0 var(--space-4);
    color: var(--text);
  }

  .headline {
    font-size: var(--headline-size, var(--text-hero));
    line-height: 1;
    white-space: nowrap;
  }

  .headline em {
    font-style: italic;
  }

  /* One block of variables per pairing: this is how the real site
     will switch fonts once one is picked. */
  .pairing-a {
    --font-display: 'Instrument Serif', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    --headline-size: clamp(2.75rem, 1rem + 6.4vw, 8rem);
  }

  .pairing-b {
    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'Manrope', system-ui, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
    --headline-size: clamp(2.5rem, 0.8rem + 4.6vw, 6rem);
  }

  .pairing-b .headline {
    font-weight: 400;
    font-variation-settings: 'opsz' 144;
  }

  .pairing-c {
    --font-display: 'Newsreader', Georgia, serif;
    --font-body: 'Geist', system-ui, sans-serif;
    --font-mono: 'Geist Mono', ui-monospace, monospace;
    --headline-size: clamp(2.5rem, 0.8rem + 5.4vw, 7rem);
  }

  .pairing-c .headline {
    font-weight: 400;
  }

  .pairing {
    font-family: var(--font-body);
  }

  /* Phones: the face fills the frame, so the text goes above the photo
     instead of on top of it. (The real mobile hero is designed in Stage 3.) */
  @media (max-width: 800px) {
    .hero {
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      padding: var(--margin-page) 0 0;
      overflow: visible;
    }

    .name,
    .copy {
      position: static;
      margin: 0 var(--margin-page) var(--space-5);
      max-width: none;
    }

    .copy {
      order: 1;
    }

    .hero-photo {
      position: static;
      order: 2;
      height: auto;
      aspect-ratio: 4 / 3;
      object-position: 65% 25%;
    }

    .headline {
      font-size: var(--text-2xl);
    }
  }
</style>
